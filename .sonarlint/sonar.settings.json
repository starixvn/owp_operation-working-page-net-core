{
  "sonar.exclusions": [
    "**/*.native.cs"
  ],
  "sonar.global.exclusions": [
    "**/*GlobalSuppressions.cs",
    "**/*AssemblyInfo.cs",
    "**/*.generated.cs",
    "**/*.native.*",
    "**/Global.asax.cs",
    "**/node_modules/**",
    "**/bower_components/**",
