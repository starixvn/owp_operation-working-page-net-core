@using OWP.Resources;

<div id="js-modalDialogForm" class="modal small">
    <div class="modal-header">
        <a href="javascript:;" class="modal-action modal-close waves-effect"><i class="mdi mdi-close"></i></a>
    </div>

    <div class="modal-content">
        <p><i class="mdi mdi-close-circle-outline icon-error"></i></p>
        <p class="text js-message"></p>
    </div>
    <div class="modal-footer button-block">

        <a href="javascript:;"
           class="modal-action modal-close waves-effect btn btn-confirm">
            @ViewLang.OK
        </a>
    </div>
</div>