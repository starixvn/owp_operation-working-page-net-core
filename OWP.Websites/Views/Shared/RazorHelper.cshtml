@using OWP.Resources;

@helper Pagination(params int[] itemPerPages)
{
    var arrayItemPerPage = (itemPerPages.Length == 0) ? new int[] { 50, 100, 200 } : itemPerPages;
    <div class="pagination js-pagination" style="display: none;">
        <div class="detailtext left">Showing 1 to 20 of 142 entries</div>
        <div class="paging-item">
            <div class="itemperpage">
                <span>@ViewLang.Show</span>
                <span class="input-itemPerPage">
                    <select class="js-select js-itemperpageOption">
                        @foreach (var item in arrayItemPerPage)
                        {
                            <option value="@item">@item</option>
                        }
                    </select>
                </span>
                <span>entries</span>
            </div>
            <ul id="numberlist" class="pagination border"></ul>
        </div>
    </div>
}

@helper ModalWarningMessage()
{
    <div id="js-modalWarningMessage" class="modal small">
        <div class="modal-header">
            <a href="javascript:;" class="modal-action modal-close waves-effect"><i class="mdi mdi-close"></i></a>
        </div>

        <div class="modal-content">
            <p><i class="mdi mdi-alert-outline icon-alert"></i></p>
            <p class="text js-message"></p>
        </div>
    </div>
}

