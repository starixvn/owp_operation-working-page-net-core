@helper MadalInformationMessage()
{
    <div id="js-modalInformationMessage" class="modal small">
        <div class="modal-header">
            <a href="javascript:;" class="modal-action modal-close waves-effect"><i class="mdi mdi-close"></i></a>
        </div>

        <div class="modal-content">
            <p><i class="mdi mdi-checkbox-marked-circle-outline icon-success"></i></p>
