@using OWP.Resources;
@{
    
}
@{
    var title = ViewBag.Title == null ? ViewLang.Home : ViewBag.Title;
    var baseHref = Context.Request.PathBase;
    if (baseHref != "/")
    {
        baseHref = baseHref + "/";
    }
}

<!DOCTYPE html>
<html lang="en">

<head>
    <base href="@baseHref">
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="">
    <meta name="author" content="">
    <title>@ViewLang.SystemName</title>
    <link rel="shortcut icon" type="image/ico" href="@Url.Content("~/favicon.ico")">
    @await RenderSectionAsync("css", false)
    <environment exclude="Development">
        <link href="~/styles/common" rel="stylesheet"/>
        <link href="~/styles/fonts" rel="stylesheet"/>
    </environment>
    <environment include="Development">
        <link href="~/shared/lib/Fanex.Grid/Fanex.Grid.css" rel="stylesheet"/>
        <link href="~/shared/lib/Fanex.Grid/Fanex.Pagination.css" rel="stylesheet"/>
        <link href="~/shared/lib/fanex-multiselect/fanex.multiSelect.css" rel="stylesheet"/>
        <link href="~/shared/lib/Materialize/materialize.css" rel="stylesheet"/>
        <link href="~/shared/lib/CustomScrollbar/jquery.mCustomScrollbar.css" rel="stylesheet"/>
        <link href="~/shared/lib/Select2/select2.css" rel="stylesheet"/>
        <link href="~/shared/lib/jQuery-Wizard/wizard.css" rel="stylesheet"/>
        <link href="~/shared/lib/Tipsy/tipsy.css" rel="stylesheet"/>
        <link href="~/shared/lib/Colpick/colpick.css" rel="stylesheet"/>
        <link href="~/shared/lib/SweetAlert2/sweetalert2.css" rel="stylesheet"/>
        <link href="~/shared/lib/jQueryTagsinput/jquery.tagsinput.min.css" rel="stylesheet"/>
        <link href="~/shared/lib/jquery-timepicker/jquery.timepicker.css" rel="stylesheet"/>
        <link href="~/shared/lib/MsgBox/msgbox-0.0.1.css" rel="stylesheet"/>
        <link href="~/shared/lib/SimplePagination/simplePagination.css" rel="stylesheet"/>
        <link href="~/shared/lib/Toastr/toastr.css" rel="stylesheet"/>
        <link href="~/shared/lib/Chosen/bootstrap-chosen.css" rel="stylesheet"/>
        <link href="~/shared/owp/copy.css" rel="stylesheet"/>
        <link href="~/shared/owp/owp.search-autocomplete.css" rel="stylesheet"/>
        <link href="~/shared/themes/main.css" rel="stylesheet"/>
        <link href="~/shared/themes/searchBlock.css" rel="stylesheet"/>
        <link href="~/shared/fonts/icon-OWP/style.css" rel="stylesheet"/>
        <link href="~/shared/themes/fonts/OWP-v1.0/style.css" rel="stylesheet"/>
        <link href="~/shared/themes/fonts/font-icon/style.css" rel="stylesheet"/>
        <link href="~/shared/themes/fonts/flags/flag-icon.css" rel="stylesheet"/>
    </environment>
</head>

<body class="site-menubar-fold">
    @await Component.InvokeAsync("Header", new { title = title })
    <main>
        @RenderBody()
        <div class="loading-process" style="display: none;">
            <svg class="icon-loading" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="64" height="64"
                fill="#439ff0">
                <circle transform="translate(8 0)" cx="0" cy="16" r="0">
                    <animate attributeName="r" values="0; 4; 0; 0" dur="1.2s" repeatCount="indefinite" begin="0"
                        keytimes="0;0.2;0.7;1" keySplines="0.2 0.2 0.4 0.8;0.2 0.6 0.4 0.8;0.2 0.6 0.4 0.8"
                        calcMode="spline" />
                </circle>
                <circle transform="translate(16 0)" cx="0" cy="16" r="0">
                    <animate attributeName="r" values="0; 4; 0; 0" dur="1.2s" repeatCount="indefinite" begin="0.3"
                        keytimes="0;0.2;0.7;1" keySplines="0.2 0.2 0.4 0.8;0.2 0.6 0.4 0.8;0.2 0.6 0.4 0.8"
                        calcMode="spline" />
                </circle>
                <circle transform="translate(24 0)" cx="0" cy="16" r="0">
                    <animate attributeName="r" values="0; 4; 0; 0" dur="1.2s" repeatCount="indefinite" begin="0.6"
                        keytimes="0;0.2;0.7;1" keySplines="0.2 0.2 0.4 0.8;0.2 0.6 0.4 0.8;0.2 0.6 0.4 0.8"
                        calcMode="spline" />
                </circle>
            </svg>
        </div>
    </main>
    @Html.Hidden("RootURL", Url.Content("~/"))

    @await Html.PartialAsync("_ModalWarningMessage");
    @await Html.PartialAsync("_ModalErrorMessage");
    @await Html.PartialAsync("_ModalInformationMessage");
    @await Html.PartialAsync("_ModalDialogForm");
   
    @Html.Raw(Fanex.Logging.LogManager.RenderJavascriptLogger())

    <environment exclude="Development">
        <script src="~/scripts/core" type="text/javascript"></script>
        <script src="~/scripts/common" type="text/javascript"></script>
    </environment>
    <environment include="Development">
        <script src="~/shared/lib/jQuery/jquery-2.1.1.js" type="text/javascript"></script>
        <script src="~/shared/lib/jquery.signalR-2.4.3.min.js" type="text/javascript"></script>
        <script src="~/shared/lib/JQuery/jquery-ui-1.10.4.js" type="text/javascript"></script>
        <script src="~/shared/lib/JQuery/jquery.blockUI.2.66.min.js" type="text/javascript"></script>
        <script src="~/shared/lib/Others/moment-latest.js" type="text/javascript"></script>
        <script src="~/shared/lib/Chosen/chosen.jquery.js" type="text/javascript"></script>
        <script src="~/shared/lib/MsgBox/msgbox-0.0.1.js" type="text/javascript"></script>
        <script src="~/shared/lib/jquery-timepicker/jquery.timepicker.js" type="text/javascript"></script>
        <script src="~/shared/lib/Others/namespace.js" type="text/javascript"></script>
        <script src="~/shared/lib/js.cookie/js.cookie.js" type="text/javascript"></script>
        <script src="~/shared/owp/common.js" type="text/javascript"></script>
        <script src="~/shared/lib/Materialize/materialize.js" type="text/javascript"></script>
        <script src="~/shared/lib/CustomScrollbar/jquery.mCustomScrollbar.concat.min.js"
                type="text/javascript"></script>
        <script src="~/shared/lib/Select2/select2.min.js" type="text/javascript"></script>
        <script src="~/shared/lib/jQuery-Wizard/jquery-wizard.js" type="text/javascript"></script>
        <script src="~/shared/lib/Tipsy/jquery.tipsy.js" type="text/javascript"></script>
        <script src="~/shared/lib/jQueryTagsinput/jquery.tagsinput.min.js" type="text/javascript"></script>
        <script src="~/shared/lib/Inputmask/jquery.inputmask.bundle.js" type="text/javascript"></script>
        <script src="~/shared/lib/jquery.shiftcheckbox.js" type="text/javascript"></script>
        <script src="~/shared/lib/Colpick/colpick.js" type="text/javascript"></script>
        <script src="~/shared/lib/SweetAlert2/sweetalert2.js" type="text/javascript"></script>
        <script src="~/shared/lib/Fanex.Grid/Fanex.Grid.js" type="text/javascript"></script>
        <script src="~/shared/lib/Fanex.Grid/Fanex.Pagination.js" type="text/javascript"></script>
        <script src="~/shared/lib/SimplePagination/jquery.simplePagination.js" type="text/javascript"></script>
        <script src="~/shared/lib/ContextMenu/bootstrap-contextmenu.js"></script>
        <script src="~/shared/lib/fanex-multiselect/fanex.multiSelect.js"></script>
        <script src="~/shared/lib/Toastr/toastr.js"></script>
        <script src="~/shared/lib/Sortable/Sortable.js"></script>
        <script src="~/shared/lib/favico/favico-0.3.10.min.js"></script>
        <script src="~/shared/owp/navbar.js"></script>
        <script src="~/shared/owp/main.js"></script>
        <script src="~/shared/lib/modernizr.js"></script>
        <script src="~/shared/owp/DocumentTitle/document-title.js"></script>
        <script src="~/shared/owp/DocumentTitle/document-title-factory.js"></script>
        <script src="~/shared/owp/MessageBox/message-box.js" type="text/javascript"></script>
        <script src="~/shared/owp/MessageBox/message-box-factory.js" type="text/javascript"></script>
    </environment>
    <script type="text/javascript">
        var msgNoSearchResults = '@ViewLang.QuickSearch_NoResults';

        $(document).ready(function () {
            documentTitle.CountUnreadMessage();
            if (!Notification) {
                alert('Desktop notifications not available in your browser. Try Chromium.');
                return;
            }

            if (Notification.permission !== 'granted') {
                Notification.requestPermission();
            }

        });
    </script>
    @await RenderSectionAsync("scripts", required: false)
</body>
</html>