@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title></title>
    <meta charset="utf-8" />
    <script src="~/shared/lib/jQuery/jquery-2.1.1.js" type="text/javascript"></script>
</head>
<body>
<div>
    Under Maintenance Flag has been set to <span id="flag">@ViewBag.UMFlag</span>
</div>

<button>Toggle</button>
<script type="text/javascript">
        $("button").click(function () {
            $("button").hide();
            $("#flag").text("Waiting");
            $.ajax({
                method: "POST",
                contentType: "text",
                url: "MountUMToggle", success: function (result) {
                    $("#flag").text(result);
                    $("button").show();
                }
            });
        });
    </script>
</body>
</html>