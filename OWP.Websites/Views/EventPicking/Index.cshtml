@using Microsoft.AspNetCore.Mvc.TagHelpers
@using OWP.Resources
@using OWP.Extensions
@using OWP.Utils
@model DateTime;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = ViewLang.EventPicking;
    var eventDate = Model.ToGmt8();
}

@section css
{
    <environment include="Development">
        <link href="~/shared/owp/TaskList/TaskList.css" rel="stylesheet" />
        <link href="~/shared/owp/EventManagement/Resources/EventInformation/EventInformation.css" rel="stylesheet" />
    </environment>
    <environment exclude="Development">
        <link href="Styles/EventPicking" rel="stylesheet" />
    </environment>
}

<div class="body-content">
    <form class="filter">

        <div class="row margin-bottom-0 js-controlFilter control-filter">
            <div class="input-field col calendar input--m has-margin">
                <div class="label">@ViewLang.Date</div>
                @Html.TextBox("Date", eventDate.ToOWPDateFormat(), new { @class = "js-calendar", @readonly = "readonly" })
                <i class="mdi mdi-calendar icon-calendar"></i>
            </div>
        </div>
        <div class="clearfix"></div>

        <div class="row margin-bottom-0">
            <div class="button-block col no-pad-top">
                @*<a class="waves-effect waves-light btn btn-search js-btnSearch">@ViewLang.Search</a>*@
                <a class="waves-effect waves-light btn btn-search js-btnExcel">Export Excel</a>
            </div>
        </div>
    </form>

    <div class="table">
        <div id="js-listEventPicking"></div>
    </div>
</div>

@section scripts
{
    <environment include="Development">
        <script src="~/shared/owp/EventPicking/event-picking-factory.js" asp-append-version="true"></script>
        <script src="~/shared/owp/EventPicking/event-picking.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="Scripts/EventPicking"></script>
    </environment>
}