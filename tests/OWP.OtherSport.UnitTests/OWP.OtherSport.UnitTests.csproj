<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<Nullable>disable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Builder\**" />
		<Compile Remove="Helper\**" />
		<EmbeddedResource Remove="Builder\**" />
		<EmbeddedResource Remove="Helper\**" />
		<None Remove="Builder\**" />
		<None Remove="Helper\**" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="appsettings.json" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
	</ItemGroup>
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="CompareNETObjects" Version="4.74.0" />
		<PackageReference Include="EPPlus" Version="5.5.4" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.0.0" />
		<PackageReference Include="NSubstitute" Version="4.2.2" />
		<PackageReference Include="xunit" Version="2.4.1" />
		<PackageReference Include="xUnit.Asserts.Compare" Version="1.0.0.5" />
	<PackageReference Include="xunit.runner.visualstudio" Version="2.4.3">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\OWP.OtherSport\OWP.OtherSport.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="App_Data\Templates\" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="..\..\OWP.Websites\App_Data\Templates\ExportOSAssignmentTemplate.xlsx" Link="App_Data\Templates\ExportOSAssignmentTemplate.xlsx">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
</Project>