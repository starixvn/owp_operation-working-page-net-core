    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="CompareNETObjects" Version="4.79.0" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.7.0" />
